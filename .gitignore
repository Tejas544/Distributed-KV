build/
out/
.scratch/
cmake-build-*/
compile_commands.json
.cache/
CMakeUserPresets.json

# Simulation artifacts. Traces are large and regenerable from the seed, which is
# the entire point -- the seed goes in the ledger, the trace does not go in git.
artifacts/
*.jsonl
*.trace

# Explicitly NOT ignored: test/corpus/*.seed. Those are pinned regression seeds,
# one per fixed bug, and they are the smallest and most valuable files here.
!test/corpus/*.seed

*.o
*.a
*.so
*.dylib
*.dll
*.exe
*.pdb

.vscode/
.idea/
*.swp
.DS_Store

# Leiningen's build output for the Elle cross-validation harness. The project
# and its source are tracked; the compiled classes and the dependency cache are
# not, and neither is tla2tools.jar -- tools/fetch_tla.sh and
# tools/fetch_elle.sh exist so that a 2 MB binary and a 100 MB jar cache do not
# live in a source tree where nobody would ever upgrade them.
tools/elle/target/

# TLC's own scratch: a states/ directory per run, holding the fingerprint set
# and any counterexample dump. Regenerable by tools/tlc.sh.
spec/states/

# Seed-fleet output. Regenerable by tools/fleet.sh from the seeds, which is the
# whole point -- the seed goes in the ledger, the JSONL does not go in git.
fleet/
*.fleet.jsonl
