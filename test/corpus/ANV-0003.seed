# ANV-0003 -- WAL recovery treated EIO as end-of-log and then abandoned the node.
# Node 5 came back with 12 of 60 records and never retried.
seed        = 48
workload    = counter
nodes       = 5
faults      = drawn from seed
invariant   = INV-LIVE-07 (replicas converge after faults heal)
reproduce   = anvil-sim --seed 48 --workload counter --faults
expect      = converged=yes, lost writes=0
found_at    = <initial commit>
fixed_at    = <initial commit>
